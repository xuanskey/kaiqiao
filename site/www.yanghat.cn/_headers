# Shared security headers; no catch-all Cache-Control to avoid merged cache policies.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Only hashed application bundles and this versioned cover are immutable.
/app/assets/*
  Cache-Control: public, max-age=31536000, immutable
/assets/og-cover-20261029.jpg
  Cache-Control: public, max-age=31536000, immutable

# Unversioned brand/media files: short cache, safe to replace under the same name.
/assets/brand.svg
  Cache-Control: public, max-age=3600
/assets/favicon.svg
  Cache-Control: public, max-age=3600
/assets/lantern.svg
  Cache-Control: public, max-age=3600
/assets/kaiqiao-promo-poster.jpg
  Cache-Control: public, max-age=3600
/assets/kaiqiao-promo.mp4
  Cache-Control: public, max-age=3600

# Query-string versions do not select _headers rules; always revalidate these paths.
/styles.css
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache

# Documents and service workers must revalidate.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/app/
  Cache-Control: no-cache
/app/index.html
  Cache-Control: no-cache
/app/sw.js
  Cache-Control: no-cache
/sw-practice.js
  Cache-Control: no-cache

# Canonical hints only; real 301 is a later Cloudflare redirect rule.
https://yanghat.cn/*
  Link: <https://www.yanghat.cn/:splat>; rel="canonical"
/domain-transition.js
  Cache-Control: no-cache

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: no-cache
/grade/*
  Cache-Control: no-cache
/404.html
  Cache-Control: no-cache
/app/*
  X-Robots-Tag: noindex
/metrics.js
  Cache-Control: no-cache
/metrics-config.js
  Cache-Control: no-cache
/landing-track.js
  Cache-Control: no-cache

/pelican.css
  Cache-Control: no-cache
/assets/pelican.svg
  Cache-Control: public, max-age=3600

/manifest.webmanifest
  Cache-Control: no-cache

/install.js
  Cache-Control: no-cache

/assets/pwa-192.png
  Cache-Control: public, max-age=3600

/assets/pwa-512.png
  Cache-Control: public, max-age=3600

/assets/pwa-maskable-512.png
  Cache-Control: public, max-age=3600

/assets/apple-touch-icon.png
  Cache-Control: public, max-age=3600

/topup
  Cache-Control: no-cache

/topup/
  Cache-Control: no-cache

/topup/index.html
  Cache-Control: no-cache

/topup.js
  Cache-Control: no-cache

/topup-core.js
  Cache-Control: no-cache

/topup-config.js
  Cache-Control: no-cache

/assets/wechat-pay-qr.png
  Cache-Control: public, max-age=3600

/assets/wechat-service-qr.png
  Cache-Control: public, max-age=3600
